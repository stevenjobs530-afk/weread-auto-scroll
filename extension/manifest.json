{
  "manifest_version": 3,
  "name": "微信读书自动滚动 · WeRead Auto Scroll",
  "version": "1.4.2",
  "description": "微信读书网页自动滚动工具：20 档速度、数字快捷键、回车开始或暂停，附中文使用说明。偏好仅保存在本地。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://weread.qq.com/web/reader/*"
      ],
      "js": [
        "scroll-core.js",
        "reader-layout.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
